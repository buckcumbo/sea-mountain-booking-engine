{
  "name": "One-Time Hospitable Enrich",
  "description": "Runs once: merges editorial content from original records into Hospitable-imported homes, pulls missing descriptions, and fills same-building siblings. Safe to delete after it fires.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "one_time_hospitable_enrich",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enrich_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFromHospitable",
            "args": {
              "mode": "enrich-all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run full enrichment",
            "description": "Merge legacy content + descriptions + sibling fill"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-07-25T21:52:00Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}