{
  "name": "Inquiry Alerts",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inquiry_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInquiryAlerts",
            "args": {
              "inquiryId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send inquiry alert",
            "description": "Email admins about the new inquiry"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Inquiry"
    }
  },
  "description": "Emails admins when a new inquiry is submitted."
}