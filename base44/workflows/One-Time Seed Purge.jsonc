{
  "name": "One-Time Seed Purge",
  "description": "Runs once: deletes the original mock/seed listings (their editorial content is already merged into the real Hospitable homes) in batches, then re-runs the listings import so real homes reclaim the clean URL slugs. Safe to delete after it fires.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "one_time_seed_purge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "purge_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "purgeSeedListings",
            "args": {
              "confirm": "PURGE"
            }
          },
          "then": "purge_2",
          "x-base44": {
            "title": "Purge batch 1",
            "description": "Delete up to 40 seed listings + calendar rows"
          }
        }
      },
      {
        "purge_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "purgeSeedListings",
            "args": {
              "confirm": "PURGE"
            }
          },
          "then": "purge_3",
          "x-base44": {
            "title": "Purge batch 2",
            "description": "Delete up to 40 seed listings + calendar rows"
          }
        }
      },
      {
        "purge_3": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "purgeSeedListings",
            "args": {
              "confirm": "PURGE"
            }
          },
          "then": "reclaim_1",
          "x-base44": {
            "title": "Purge batch 3",
            "description": "Delete remaining seed listings + calendar rows"
          }
        }
      },
      {
        "reclaim_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFromHospitable",
            "args": {
              "mode": "listings",
              "page": 1
            }
          },
          "then": "reclaim_2",
          "x-base44": {
            "title": "Reclaim slugs page 1",
            "description": "Re-import listings so clean slugs transfer to real homes"
          }
        }
      },
      {
        "reclaim_2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFromHospitable",
            "args": {
              "mode": "listings",
              "page": 2
            }
          },
          "then": "reclaim_3",
          "x-base44": {
            "title": "Reclaim slugs page 2",
            "description": "Re-import listings page 2"
          }
        }
      },
      {
        "reclaim_3": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFromHospitable",
            "args": {
              "mode": "listings",
              "page": 3
            }
          },
          "then": "reclaim_4",
          "x-base44": {
            "title": "Reclaim slugs page 3",
            "description": "Re-import listings page 3"
          }
        }
      },
      {
        "reclaim_4": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importFromHospitable",
            "args": {
              "mode": "listings",
              "page": 4
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reclaim slugs page 4",
            "description": "Re-import listings page 4"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-07-25T22:07:00Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}