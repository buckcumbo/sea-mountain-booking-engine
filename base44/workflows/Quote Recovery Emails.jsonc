{
  "name": "Quote Recovery Emails",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Hourly: expires stale quotes and sends one recovery email to abandoned quotes that have an email on file.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quote_recovery_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "recover": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendQuoteRecoveryEmails"
          },
          "then": "end",
          "x-base44": {
            "title": "Send quote recovery emails",
            "description": "Expire stale quotes and email abandoned ones"
          }
        }
      }
    ]
  }
}