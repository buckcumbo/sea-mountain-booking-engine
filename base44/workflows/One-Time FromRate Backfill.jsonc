{
  "name": "One-Time FromRate Backfill",
  "description": "Runs once: computes the precomputed fromRate for every listing so card pricing works immediately. The nightly Data Retention workflow keeps it fresh afterward. Safe to delete after it fires.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "one_time_fromrate_backfill",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshFromRates",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Backfill from-rates",
            "description": "Compute lowest upcoming nightly rate per listing"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-07-25T23:02:00Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}