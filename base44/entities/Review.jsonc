{
  "name": "Review",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "guestName": {
      "type": "string"
    },
    "stayDate": {
      "type": "string",
      "format": "date"
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "listingId",
    "rating",
    "guestName"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}