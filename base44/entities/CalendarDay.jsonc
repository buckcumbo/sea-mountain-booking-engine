{
  "name": "CalendarDay",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "rate": {
      "type": "number",
      "default": 0
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "minNights": {
      "type": "number",
      "default": 1
    },
    "syncedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "listingId",
    "date"
  ]
}