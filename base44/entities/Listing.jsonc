{
  "name": "Listing",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "Myrtle Beach",
        "North Myrtle Beach",
        "Surfside Beach",
        "Garden City",
        "Murrells Inlet",
        "Pawleys Island"
      ],
      "default": "Myrtle Beach"
    },
    "bedrooms": {
      "type": "number",
      "default": 1
    },
    "bathrooms": {
      "type": "number",
      "default": 1
    },
    "max_occupancy": {
      "type": "number",
      "default": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "area"
  ]
}