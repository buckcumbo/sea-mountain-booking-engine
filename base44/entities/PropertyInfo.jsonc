{
  "name": "PropertyInfo",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Ref to Listing \u2014 one PropertyInfo per listing (unique in code)"
    },
    "address": {
      "type": "string",
      "description": "Full street address \u2014 revealed to guests only after their reservation is confirmed"
    },
    "parkingInfo": {
      "type": "string",
      "description": "Where to park, passes needed, trailer rules"
    },
    "wifiName": {
      "type": "string"
    },
    "wifiPassword": {
      "type": "string",
      "description": "Revealed in the guest trip portal only within 7 days of check-in"
    },
    "checkInNotes": {
      "type": "string",
      "description": "Anything arrival-specific: gate codes context, elevator, which door"
    },
    "houseManual": {
      "type": "string",
      "description": "House manual text (markdown ok): thermostat, trash day, pool rules, TV"
    }
  },
  "required": [
    "listingId"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}