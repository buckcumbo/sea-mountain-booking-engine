{
  "name": "GuestProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "marketingConsent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "stayCount": {
      "type": "number",
      "default": 0
    },
    "lifetimeValue": {
      "type": "number",
      "default": 0
    },
    "preferences": {
      "type": "object"
    }
  },
  "required": [
    "email",
    "firstName",
    "lastName"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}