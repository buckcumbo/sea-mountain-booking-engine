{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "guestyId": {
      "type": "string"
    },
    "syncedAt": {
      "type": "string",
      "format": "date-time"
    },
    "listingId": {
      "type": "string"
    },
    "guestProfileId": {
      "type": "string"
    },
    "checkIn": {
      "type": "string",
      "format": "date"
    },
    "checkOut": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "paymentStatus": {
      "type": "string"
    },
    "totalAmount": {
      "type": "number",
      "default": 0
    },
    "balanceDue": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "direct",
        "airbnb",
        "vrbo"
      ],
      "default": "direct"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "guestyId",
    "listingId",
    "guestProfileId",
    "checkIn",
    "checkOut"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}