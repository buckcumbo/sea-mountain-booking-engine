{
  "name": "Quote",
  "type": "object",
  "properties": {
    "guestyQuoteId": {
      "type": "string"
    },
    "listingId": {
      "type": "string"
    },
    "checkIn": {
      "type": "string",
      "format": "date"
    },
    "checkOut": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number",
      "default": 1
    },
    "invoice": {
      "type": "object"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "booked",
        "expired"
      ],
      "default": "active"
    },
    "email": {
      "type": "string"
    },
    "recoveryEmailSentAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "guestyQuoteId",
    "listingId",
    "checkIn",
    "checkOut"
  ]
}